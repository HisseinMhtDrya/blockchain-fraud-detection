# Copiez ce fichier vers .env et remplacez les valeurs sur votre machine.
# L'API charge automatiquement .env au démarrage; .env est ignoré par Git.
# Ne partagez et ne commitez jamais ce fichier ou vos clés.

# Analyse Ethereum mainnet (Etherscan + RPC chain ID 1)
ETHERSCAN_API_KEY=
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_WITH_YOUR_ROTATED_KEY

# Configuration du réseau Hardhat Sepolia (déploiement)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Signataire reporter de l'API sur Sepolia
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_REPORTER_ADDRESS=
